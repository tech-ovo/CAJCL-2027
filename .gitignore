# Local development database. Never commit one: the schema lives in
# migrations/ and the data is regenerated by scripts/seed.py from a fixed seed.
*.db
*.db-wal
*.db-shm

# clasp OAuth credentials. .clasp.json holds only the script ID and IS safe to
# commit; this one holds tokens and is not.
.clasprc.json

__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
# Access codes, printed once and never recoverable. `codes.txt` is what the
# seed and the board script write now; the older name is kept so an existing
# checkout cannot commit one by accident.
codes.txt
demo-codes.txt

# Real board members' names. The repository is public and the demonstration is
# projected in a room, so no real person's name is ever committed. Copy
# board.example.json to board.json and fill it in; scripts/add_board.py reads it.
board.json

board-codes.txt

# Certamen bot dependencies & artifacts
certamen-bot/node_modules/
.DS_Store
